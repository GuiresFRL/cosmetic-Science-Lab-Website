# Contact / enquiry / careers forms (POST /api/contact) send email over SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail App Password (16 characters, no spaces)
SMTP_PASS=
# Comma-separated recipients for enquiry, supplier, partner and directory forms.
MAIL_TO=info@cosmeticsciencelab.com,info@foodresearchlab.com
# The careers form is routed to careers@guires.com via its hidden "to" field (allow-listed in the route).

# Product-problem reports (POST /api/report) are emailed to MAIL_TO, with photos attached. No database is used.
