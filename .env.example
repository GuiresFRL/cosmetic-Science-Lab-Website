# Email for every form: enquiry, supplier, partner, directory, careers, newsletter and
# product-problem reports. All forms send through lib/mail.ts using these settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail App Password (16 characters; spaces are ignored)
SMTP_PASS=
# Comma-separated recipients for all forms except careers.
MAIL_TO=info@cosmeticsciencelab.com,info@foodresearchlab.com
# The careers form is routed to careers@guires.com by its hidden "to" field (allow-listed in app/api/contact/route.ts).
